# Скопируйте в .env и заполните. .env в git не попадает.

# Ключ подписи токенов входа: openssl rand -hex 32
SECRET_KEY=change-me-openssl-rand-hex-32
# Пароль PostgreSQL этого приложения (не журнала обходов): openssl rand -hex 16
POSTGRES_PASSWORD=change-me-db-password

# Внутренний адрес API журнала обходов в сети jirajura_default.
# Для локальной разработки: https://obhod-sao.ru или http://host.docker.internal:8000
JIRAJURA_API_URL=http://api:8000

DOMAIN=luki.obhod-sao.ru
MAX_PHOTO_SIZE_MB=20
